# Application Configuration
APP_NAME=Morrow
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (PostgreSQL / NeonDB with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/morrow

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=console
